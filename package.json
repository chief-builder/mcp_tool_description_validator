{
  "name": "mcp-tool-description-validator",
  "version": "0.1.0",
  "description": "A governance validator for Model Context Protocol (MCP) tool definitions that ensures quality, security, and LLM-compatibility",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-validate": "./bin/mcp-validate.js"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "analyze:servers": "tsx scripts/test-official-servers.ts",
    "llm:analyze": "node scripts/llm-analyze.mjs",
    "validate:examples": "npm run build && node ./dist/cli.js examples/polished-tools.json && node ./dist/cli.js examples/needs-work-tools.json --format json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "validator",
    "llm",
    "ai",
    "tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ai": "^6.0.300",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "hono": "^4.13.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@modelcontextprotocol/server-memory": "^2026.8.31",
    "@modelcontextprotocol/server-sequential-thinking": "^2026.8.31",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "ollama-ai-provider-v2": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chief-builder/mcp_tool_description_validator.git"
  }
}
