{
  "name": "mcp-tool-validator",
  "version": "0.1.0",
  "description": "A governance validator for Model Context Protocol (MCP) tool definitions that ensures quality, security, and LLM-compatibility",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-validate": "./bin/mcp-validate.js"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "analyze:servers": "tsx scripts/test-official-servers.ts",
    "llm:analyze": "node scripts/llm-analyze.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "validator",
    "llm",
    "ai",
    "tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ai": "^6.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "chalk": "^5.0.0",
    "commander": "^14.0.0",
    "cosmiconfig": "^9.0.0",
    "hono": "^4.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@modelcontextprotocol/server-everything": "^2025.12.18",
    "@modelcontextprotocol/server-filesystem": "^2025.12.18",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@modelcontextprotocol/server-memory": "^2025.11.25",
    "@modelcontextprotocol/server-sequential-thinking": "^2025.12.18",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "ollama-ai-provider-v2": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chief-builder/mcp_tool_description_validator.git"
  }
}
